---
interface Props {
  title?: string;
  lead?: string;
  description?: string;
  bgImage: string;
  bgImageMobile?: string; // Optional flag added
  
  primaryButtonText?: string;
  primaryButtonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;

  tintOpacity?: string;
}

const {
  title = "Main Headline Goes Here",
  lead,
  description,
  bgImage,
  bgImageMobile,
  primaryButtonText = "Text for primary button",
  primaryButtonLink,
  secondaryButtonText = "Text for secondary button",
  secondaryButtonLink,
  tintOpacity = "25%",
} = Astro.props;

const mobileImage = bgImageMobile ? `url('${bgImageMobile}')` : `url('${bgImage}')`;
---

<section 
  class="hero-image-banner" 
  style={`--bg-image: url('${bgImage}'); --bg-image-mobile: ${mobileImage}; --tint-opacity: ${tintOpacity};`}
>
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-text-group">
      <h1 class="hero-title">{title}</h1>
      {lead && <p class="hero-lead">{lead}</p>}
      {description && <p class="hero-description">{description}</p>}
    </div>

    {(primaryButtonLink || secondaryButtonLink) && (
      <div class="hero-actions">
        {primaryButtonLink && (
          <a href={primaryButtonLink} class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{primaryButtonText}</span>
          </a>
        )}

        {secondaryButtonLink && (
          <a href={secondaryButtonLink} class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>{secondaryButtonText}</span>
          </a>
        )}

        <!-- Changed class from btn-secondary to btn-transparent -->
        <a 
          href="#about" 
          class="btn-transparent" 
          aria-label="Scroll to next section"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M19 12l-7 7-7-7"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .hero-image-banner {
    min-height: 100dvh;
    width: 100%;
    position: relative;
    padding: 8.5rem 1.5rem 4rem;
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px), (max-width: 1024px) and (orientation: portrait) {
    .hero-image-banner {
      background-image: var(--bg-image-mobile);
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, #000000 var(--tint-opacity, 25%), transparent);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: var(--max-width-wide);
    margin: 0 auto;
    text-align: center;
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  .hero-text-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    margin-top: 1rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.85rem);
    line-height: 1.1;
    color: var(--text-primary);
    max-width: 900px;
    margin: 0;
  }

  .hero-lead {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.4;
    max-width: 800px;
    margin: 0;
  }

  .hero-description {
    font-size: var(--font-size-lg);
    line-height: 1.65;
    color: var(--text-primary);
    max-width: 760px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    margin-top: auto;
  }
</style>