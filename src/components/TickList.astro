---
// src/components/TickList.astro

interface Props {
  eyebrow?: string;
  title?: string;
  items?: string[];
}

const {
  eyebrow,
  title,
  items = [],
} = Astro.props;
---

<section class="services-simple-section" id="about">
  <div class="services-simple-container">
    
    {(eyebrow || title) && (
      <div class="section-header">
        {eyebrow && <span class="section-eyebrow">{eyebrow}</span>}
        {title && <h2 class="section-title">{title}</h2>}
      </div>
    )}

    {items && items.length > 0 && (
      <ul class="services-list-grid">
        {items.map((item) => (
          <li class="service-item">
            <div class="check-icon">
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                width="18" 
                height="18" 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2.5" 
                stroke-linecap="round" 
                stroke-linejoin="round"
                aria-hidden="true"
                >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <span class="service-text">{item}</span>
          </li>
        ))}
      </ul>
    )}

  </div>
</section>

<style>
  .services-simple-section {
    padding: 1.25rem;
    background-color: var(--background);
  }

  .services-simple-container {
    max-width: var(--max-width-wide, 71.25rem);
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-family-base);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--text-primary);
    line-height: 1.15;
    margin: 0;
  }

  /* Grid Container */
  .services-list-grid {
    list-style: none;
    max-width: 720px;
    padding: 0;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  /* List Item Card */
  .service-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background-color: var(--background);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 2px 4px rgba(11, 34, 64, 0.02);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .service-item:hover {
    transform: translateY(-2px);
    border-color: var(--border-subtle);
    box-shadow: 0 6px 16px rgba(11, 34, 64, 0.06);
  }

  /* Checkmark Badge */
  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  /* Service Title Text */
  .service-text {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
    text-align: left;
  }

  /* Mobile Portrait Adjustments */
  @media (max-width: 640px) {
    .services-simple-section {
      padding: 3rem 1rem;
    }

    .services-list-grid {
      grid-template-columns: 1fr;
      gap: 0.875rem;
    }

    .service-item {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.5rem;
      padding: 1.25rem 1rem;
    }

    .service-text {
      text-align: center;
    }
  }
</style>