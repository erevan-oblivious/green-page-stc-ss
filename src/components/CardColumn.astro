---
interface ColumnItem {
  number?: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items?: ColumnItem[];
}

const defaultItems: ColumnItem[] = [
  {
    number: "01",
    title: "Feature or Value 01",
    description: "Detailed explanation of this specific value, feature, or key step in your workflow."
  },
  {
    number: "02",
    title: "Feature or Value 02",
    description: "Detailed explanation of this specific value, feature, or key step in your workflow."
  },
  {
    number: "03",
    title: "Feature or Value 03",
    description: "Detailed explanation of this specific value, feature, or key step in your workflow."
  }
];

const {
  eyebrow,
  title,
  subtitle,
  items = defaultItems
} = Astro.props;
---

<section class="card-column-section">
  <div class="card-column-container">
    
    <!-- Section Header -->
    {(eyebrow || title || subtitle) && (
      <header class="card-column-header">
        {eyebrow && <span class="card-column-eyebrow">{eyebrow}</span>}
        {title && <h2 class="card-column-title">{title}</h2>}
        {subtitle && <p class="card-column-subtitle">{subtitle}</p>}
      </header>
    )}

    <!-- Cards Grid -->
    <div class="card-column-grid">
      {items.map((item) => (
        <article class="card-column-card">
          {item.number && <div class="card-column-number">{item.number}</div>}
          <h3 class="card-column-card-title">{item.title}</h3>
          <p class="card-column-card-description">{item.description}</p>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .card-column-section {
    padding: 6rem 1.5rem;
    background-color: var(--primary);
    width: 100%;
    color: var(--text-primary);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .card-column-container {
    max-width: var(--max-width-wide, 71.25rem);
    margin: 0 auto;
  }

  /* Header Typography */
  .card-column-header {
    text-align: center;
    max-width: 45rem;
    margin: 0 auto 4rem;
  }

  .card-column-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.75rem;
  }

  .card-column-title {
    font-family: var(--font-family-base);
    font-size: clamp(2.25rem, 4vw, 3.125rem);
    color: var(--text-primary);
    line-height: 1.15;
    margin: 0 0 1rem 0;
  }

  .card-column-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Grid Layout */
  .card-column-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  /* Individual Card */
  .card-column-card {
    position: relative;
    padding: 1.75rem;
    background-color: var(--primary, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md, 8px);
    transition: transform 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }

  .card-column-card:hover {
    transform: translateY(-3px);
    border-color: var(--text-primary);
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* Number Indicator */
  .card-column-number {
    font-family: var(--font-family-base);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    display: inline-block;
    border-bottom: 1.5px solid var(--text-secondary);
    padding-bottom: 0.25rem;
  }

  .card-column-card-title {
    font-family: var(--font-family-base);
    font-size: var(--font-size-lg, 1.25rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    margin: 0 0 0.75rem 0;
  }

  .card-column-card-description {
    font-size: var(--font-size-base, 1rem);
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 640px) {
    .card-column-section {
      padding: 4rem 1rem;
    }

    .card-column-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>