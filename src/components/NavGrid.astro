---
interface CardItem {
  title: string;
  description: string;
  link: string;
  linkText?: string;
  accent?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items?: CardItem[];
}

const defaultItems: CardItem[] = [
  {
    title: "Primary Services",
    description: "Comprehensive solutions tailored to your needs, delivered with consistency and attention to detail.",
    link: "/services",
    linkText: "Explore Services",
    accent: "primary"
  },
  {
    title: "About Our Business",
    description: "Learn more about us, our values, and our commitment to exceptional service quality.",
    link: "/about",
    linkText: "Read Our Story",
    accent: "secondary"
  },
  {
    title: "Contact Us",
    description: "Get in touch with us",
    link: "/contact",
    linkText: "Contact Us",
    accent: "primary"
  }
];

const {
  eyebrow,
  title,
  subtitle,
  items = defaultItems
} = Astro.props;
---

<section class="nav-grid-section">
  <div class="nav-grid-container">

    {(eyebrow || title || subtitle) && (
      <header class="section-header">
        {eyebrow && <span class="section-eyebrow">{eyebrow}</span>}
        {title && <h2 class="section-title">{title}</h2>}
        {subtitle && <p class="section-subtitle">{subtitle}</p>}
      </header>
    )}

    <div class="cards-grid">
      {items.map((item) => (
        <a href={item.link} class={`nav-card ${item.accent ? `accent-${item.accent}` : ''}`}>
          <!-- Decorative Accent Border -->
          <div class="card-border-top"></div>
          
          <div class="card-content">
            <h3 class="card-title">{item.title}</h3>
            <p class="card-description">{item.description}</p>
            
            <div class="card-action">
              <span class="action-text">{item.linkText || "Learn More"}</span>
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                width="18" 
                height="18" 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2" 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                class="action-arrow"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .nav-grid-section {
    padding: 5rem 1.5rem;
    background-color: var(--primary);
  }

  .nav-grid-container {
    max-width: var(--max-width-wide, 71.25rem);
    margin: 0 auto;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }

  .section-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-family-base);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--text-primary);
    line-height: 1.15;
    margin: 0 0 0.75rem 0;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
  }

  /* Card Container */
  .nav-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--background);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md, 8px);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease;
  }

  /* Top Border Accent Line */
  .card-border-top {
    height: 3px;
    width: 100%;
    background-color: transparent;
    transition: background-color 0.25s ease;
  }

  .nav-card.accent-primary .card-border-top {
    background-color: var(--text-primary);
  }

  .nav-card.accent-secondary .card-border-top {
    background-color: var(--secondary);
  }

  /* Inner Padding */
  .card-content {
    padding: 2rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  /* Typography */
  .card-title {
    font-family: var(--font-family-base);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    margin: 0 0 0.75rem 0;
    transition: color 0.2s ease;
  }

  .card-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }

  /* Action Link & Animated Arrow */
  .card-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: auto;
  }

  .action-arrow {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }

  /* Hover States */
  .nav-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-subtle);
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.25);
  }

  .nav-card:hover .card-title,
  .nav-card:hover .action-text {
    color: var(--text-primary);
  }

  .nav-card:hover .action-arrow {
    transform: translateX(5px);
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .nav-grid-section {
      padding: 3.5rem 1rem;
    }
    
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>